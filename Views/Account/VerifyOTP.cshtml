@model CarRentalSystem.Models.VerifyOtpViewModel
@{ Layout = null; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verify Email - DriveEase</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<div class="login-page">
    <div class="login-card" style="max-width:440px">
        <div class="login-logo">
            <div class="icon" style="background:linear-gradient(135deg,#065f46,#059669)"><i class="fas fa-envelope-open-text"></i></div>
            <div class="login-title">Check Your Email</div>
            <div class="login-subtitle">We sent a 6-digit code to<br/><strong>@Model.Email</strong></div>
        </div>
        @if (TempData["Success"] != null) { <div class="alert alert-success py-2 mb-3"><i class="fas fa-check-circle me-1"></i>@TempData["Success"]</div> }
        @if (TempData["Error"]   != null) { <div class="alert alert-danger  py-2 mb-3"><i class="fas fa-exclamation-circle me-1"></i>@TempData["Error"]</div> }
        <form asp-action="VerifyOtp" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Email" />
            @if (!ViewData.ModelState.IsValid)
            { <div class="alert alert-danger py-2 mb-3">@Html.ValidationSummary(false, null, new { @class="mb-0" })</div> }
            <div class="mb-4">
                <label class="form-label text-center d-block text-muted mb-3">Enter your 6-digit code</label>
                <div class="code-input-group">
                    <input class="code-box form-control" type="text" maxlength="1" inputmode="numeric" autofocus />
                    <input class="code-box form-control" type="text" maxlength="1" inputmode="numeric" />
                    <input class="code-box form-control" type="text" maxlength="1" inputmode="numeric" />
                    <input class="code-box form-control" type="text" maxlength="1" inputmode="numeric" />
                    <input class="code-box form-control" type="text" maxlength="1" inputmode="numeric" />
                    <input class="code-box form-control" type="text" maxlength="1" inputmode="numeric" />
                </div>
                <input type="hidden" asp-for="OtpCode" id="codeInput" />
                <span asp-validation-for="OtpCode" class="text-danger small d-block text-center mt-2"></span>
            </div>
            <button type="submit" class="btn-login" style="background:linear-gradient(135deg,#065f46,#059669)">
                <i class="fas fa-check me-2"></i>Verify &amp; Go to Dashboard
            </button>
        </form>
        <div class="text-center mt-3">
            <p class="text-muted mb-2" style="font-size:13px"><i class="fas fa-clock me-1"></i>Code expires in <strong>10 minutes</strong></p>
            <form asp-action="ResendOtp" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="fas fa-redo me-1"></i>Resend Code</button>
            </form>
        </div>
        <div class="text-center mt-3">
            <a asp-action="Login" class="text-muted" style="font-size:13px"><i class="fas fa-arrow-left me-1"></i>Back to Login</a>
        </div>
    </div>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js"></script>
</body></html>