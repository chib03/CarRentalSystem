@{
    Layout = null; ViewData["Title"] = "Forgot Password";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Forgot Password - DriveEase</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="login-logo">
                <div class="icon" style="background:linear-gradient(135deg,#92400e,#d97706)">
                    <i class="fas fa-key"></i>
                </div>
                <div class="login-title">Forgot Password</div>
                <div class="login-subtitle">Enter your email and we'll send a reset code</div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 mb-3">
                    <i class="fas fa-check-circle me-1"></i>@TempData["Success"]
                </div>
            }
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3">
                    @Html.ValidationSummary(false, null, new { @class = "mb-0" })
                </div>
            }

            <form asp-action="ForgotPassword" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label class="form-label">Registered Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-envelope text-muted"></i></span>
                        <input type="email" name="email" class="form-control"
                               placeholder="yourname@gmail.com" required />
                    </div>
                </div>
                <button type="submit" class="btn-login"
                        style="background:linear-gradient(135deg,#92400e,#d97706)">
                    <i class="fas fa-paper-plane me-2"></i>Send Reset Code
                </button>
            </form>

            <div class="text-center mt-4">
                <a asp-action="Login" class="text-muted" style="font-size:13px">
                    <i class="fas fa-arrow-left me-1"></i>Back to Login
                </a>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>