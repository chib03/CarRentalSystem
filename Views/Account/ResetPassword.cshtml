@model ResetPasswordViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - DriveEase</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="login-logo text-center">
                <div class="icon" style="background:linear-gradient(135deg,#065f46,#059669); width:60px; height:60px; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto; color:white;">
                    <i class="fas fa-lock-open"></i>
                </div>
                <h4 class="fw-bold mt-2">Reset Password</h4>
                <p class="text-muted small">Enter the code sent to<br /><strong>@Model.Email</strong></p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 mb-3 small">
                    @Html.ValidationSummary(false)
                </div>
            }

            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="OtpCode" id="hiddenOtpInput" />

                <div class="mb-3">
                    <label class="form-label small">6-Digit Code</label>
                    <div class="d-flex gap-2 justify-content-center">
                        <input class="code-box form-control text-center fw-bold" type="text" maxlength="1" style="width:40px; height:45px;" autofocus />
                        <input class="code-box form-control text-center fw-bold" type="text" maxlength="1" style="width:40px; height:45px;" />
                        <input class="code-box form-control text-center fw-bold" type="text" maxlength="1" style="width:40px; height:45px;" />
                        <input class="code-box form-control text-center fw-bold" type="text" maxlength="1" style="width:40px; height:45px;" />
                        <input class="code-box form-control text-center fw-bold" type="text" maxlength="1" style="width:40px; height:45px;" />
                        <input class="code-box form-control text-center fw-bold" type="text" maxlength="1" style="width:40px; height:45px;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Min. 6 characters" required />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Repeat password" required />
                    </div>
                </div>

                <button type="submit" class="btn w-100 text-white fw-bold" style="background:linear-gradient(135deg,#065f46,#059669)">
                    RESET PASSWORD
                </button>
            </form>

            <div class="text-center mt-3 small">
                <a asp-action="Login" class="text-decoration-none text-muted"><i class="fas fa-arrow-left"></i> Back to Login</a>
            </div>
        </div>
    </div>

    <script>
        const boxes = document.querySelectorAll('.code-box');
        const hiddenInput = document.getElementById('hiddenOtpInput');

        boxes.forEach((box, index) => {
            box.addEventListener('input', (e) => {
                if (e.target.value && index < boxes.length - 1) boxes[index + 1].focus();
                updateHiddenValue();
            });
            box.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !e.target.value && index > 0) boxes[index - 1].focus();
            });
        });

        function updateHiddenValue() {
            let code = "";
            boxes.forEach(box => code += box.value);
            hiddenInput.value = code;
        }
    </script>
</body>
</html>