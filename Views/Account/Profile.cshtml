@model CarRentalSystem.Models.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
    var customer = ViewBag.Customer as CarRentalSystem.Models.Customer;
}

<div class="container mt-4">
    <h2 class="fw-bold mb-4"><i class="fas fa-user-circle me-2"></i>My Profile</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm p-4 border-0">
                <form asp-action="UpdateProfile" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Full Name</label>
                            <input type="text" class="form-control bg-light" value="@Model.FullName" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email</label>
                            <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input type="text" name="phone" class="form-control" value="@(customer?.Phone ?? Model.Phone)" placeholder="Enter phone number" />
                    </div>

                    @if (Model.Role == "Customer")
                    {
                        <div class="mb-3">
                            <label class="form-label fw-bold">Address</label>
                            <textarea name="address" class="form-control" rows="2" placeholder="Street, City, Province">@(customer?.Address ?? Model.Address)</textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">License Number</label>
                            <input type="text" name="licenseNumber" class="form-control" value="@(customer?.LicenseNumber ?? Model.LicenseNumber)" placeholder="N01-XX-XXXXXX" />
                        </div>
                    }
                    else
                    {
                        <input type="hidden" name="address" value="@(customer?.Address ?? Model.Address)" />
                        <input type="hidden" name="licenseNumber" value="@(customer?.LicenseNumber ?? Model.LicenseNumber)" />
                    }

                    <div class="text-start border-top pt-3">
                        <button type="submit" class="btn btn-primary fw-bold px-4">
                            <i class="fas fa-save me-2"></i>Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4 border-0 bg-light">
                <h5 class="fw-bold mb-3"><i class="fas fa-shield-alt me-2 text-success"></i>Security</h5>
                <p class="small text-muted">Keep your account secure by managing your password.</p>
                <a asp-action="ChangePassword" class="btn btn-outline-secondary btn-sm w-100">
                    Change Password
                </a>
            </div>
        </div>
    </div>
</div>