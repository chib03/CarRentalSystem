@model CarRentalSystem.Models.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - DriveEase</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="login-page">
        <div class="login-card">
            <div class="login-logo">
                <div class="icon"><i class="fas fa-car"></i></div>
                <div class="login-title">DriveEase</div>
                <div class="login-subtitle">Car Rental Management System</div>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success py-2 mb-3">
                    <i class="fas fa-check-circle me-1"></i>@TempData["Success"]
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger py-2 mb-3">
                    <i class="fas fa-exclamation-circle me-1"></i>@TempData["Error"]
                </div>
            }

            <form asp-action="Login" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 mb-3">
                        @Html.ValidationSummary(false, null, new { @class = "mb-0" })
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Username" class="form-label">Username or Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-user text-muted"></i></span>
                        <input asp-for="Username" class="form-control"
                               placeholder="Enter username or email" autocomplete="username" />
                    </div>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fas fa-lock text-muted"></i></span>

                        <input asp-for="Password" type="password" class="form-control"
                               placeholder="Enter password" id="passwordInput"
                               style="-webkit-text-security: disc; text-security: disc;" />

                       
                    </div>
                </div>

                <div class="mb-4 d-flex justify-content-between align-items-center">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label text-muted">Remember me</label>
                    </div>
                    <a asp-action="ForgotPassword" style="font-size:13px; color:#2563a8; text-decoration:none;">
                        Forgot password?
                    </a>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt me-2"></i>Sign In
                </button>
            </form>

            <div class="text-center mt-4">
                <span class="text-muted" style="font-size:14px">New here?</span>
                <a asp-action="Register" class="ms-1 fw-semibold" style="color:#1a3a5c; font-size:14px">
                    <i class="fas fa-user-plus me-1"></i>Create Account
                </a>
            </div>

            <div class="mt-3 p-3 rounded" style="background:#f8fafc; border:1px solid #e5e7eb;">
                <small class="text-muted d-block mb-1"><strong>Admin Login:</strong></small>
                <small class="text-muted">Username: <code>admin</code> &nbsp;|&nbsp; Password: <code>Admin@123</code></small>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
   

  
</body>
</html>