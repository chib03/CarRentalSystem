@model CarRentalSystem.Models.Car
@{ ViewData["Title"] = "Car Details"; }
<div class="page-header">
    <h1 class="page-title"><i class="fas fa-car me-2"></i>@Model.Brand @Model.Model</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary-custom"><i class="fas fa-edit me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-md-5">
        <div class="form-card">
            <div class="text-center mb-3 p-4" style="background:linear-gradient(135deg,#0f2540,#1a3a5c);border-radius:10px;color:white">
                <div style="font-size:60px">🚗</div>
                <h4>@Model.Brand @Model.Model</h4>
                <span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span>
            </div>
            <table class="table table-borderless">
                <tr><td class="text-muted">Year</td><td><strong>@Model.Year</strong></td></tr>
                <tr><td class="text-muted">Plate</td><td><code>@Model.PlateNumber</code></td></tr>
                <tr><td class="text-muted">Color</td><td>@Model.Color</td></tr>
                <tr><td class="text-muted">Daily Rate</td><td><strong class="text-primary">₱@Model.DailyRate.ToString("N2")</strong></td></tr>
                <tr><td class="text-muted">Description</td><td>@(Model.Description ?? "-")</td></tr>
                <tr><td class="text-muted">Added</td><td>@Model.CreatedAt.ToString("MMM dd, yyyy")</td></tr>
            </table>
        </div>
    </div>
    <div class="col-md-7">
        <div class="table-card">
            <div class="table-header"><h6 class="fw-bold mb-0"><i class="fas fa-history me-2"></i>Rental History</h6></div>
            <table class="table mb-0">
                <thead><tr><th>Customer</th><th>Rental Date</th><th>Return Date</th><th>Amount</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.Rentals.OrderByDescending(r => r.CreatedAt))
                    {
                        <tr>
                            <td>@r.Customer?.FullName</td>
                            <td>@r.RentalDate.ToString("MMM dd")</td>
                            <td>@r.ReturnDate.ToString("MMM dd")</td>
                            <td>₱@r.TotalAmount.ToString("N0")</td>
                            <td><span class="status-badge status-@r.Status.ToLower()">@r.Status</span></td>
                        </tr>
                    }
                    @if (!Model.Rentals.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">No rental history.</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>
