@model List<CarRentalSystem.Models.Car>
@{
    ViewData["Title"] = "Cars";
}

<div class="page-header">
    <h1 class="page-title"><i class="fas fa-car me-2"></i>Cars</h1>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn-primary-custom"><i class="fas fa-plus"></i>Add Car</a>
    }
</div>

<form method="get" class="table-card p-3 mb-4 d-flex gap-2 flex-wrap align-items-end">
    <div>
        <label class="form-label mb-1" style="font-size:13px">Search</label>
        <input name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Brand, model, plate..." style="min-width:200px" />
    </div>
    <div>
        <label class="form-label mb-1" style="font-size:13px">Status</label>
        <select name="status" class="form-select form-select-sm" style="min-width:130px">
            <option value="">All Status</option>
            <option value="Available" selected="@(ViewBag.Status == "Available")">Available</option>
            <option value="Rented" selected="@(ViewBag.Status == "Rented")">Rented</option>
        </select>
    </div>
    <button type="submit" class="btn btn-sm btn-primary align-self-end">Filter</button>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary align-self-end">Reset</a>
</form>

<div class="table-card">
    <div class="table-responsive">
        <table class="table mb-0">
            <thead>
                <tr>
                    <th>Brand/Model</th>
                    <th>Year</th>
                    <th>Plate</th>
                    <th>Color</th>
                    <th>Daily Rate</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td>
                            <strong>@car.Brand @car.Model</strong><br />
                            <small class="text-muted">@car.Description</small>
                        </td>
                        <td>@car.Year</td>
                        <td><code>@car.PlateNumber</code></td>
                        <td>@car.Color</td>
                        <td>₱@car.DailyRate.ToString("N2")</td>
                        <td><span class="status-badge status-@car.Status.ToLower()">@car.Status</span></td>
                        <td>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Details" asp-route-id="@car.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@car.Id" class="btn btn-sm btn-outline-warning me-1"><i class="fas fa-edit"></i></a>
                                <form asp-action="Delete" asp-route-id="@car.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger btn-delete"><i class="fas fa-trash"></i></button>
                                </form>
                            }
                            else if (car.Status == "Available")
                            {
                                <a asp-controller="Rentals" asp-action="BookRequest" asp-route-carId="@car.Id" class="btn btn-sm btn-success">
                                    <i class="fas fa-calendar-plus me-1"></i>Book
                                </a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No cars found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js"></script>
}