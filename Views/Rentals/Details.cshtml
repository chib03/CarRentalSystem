@model CarRentalSystem.Models.RentalTransaction
@{ ViewData["Title"] = "Rental Details"; }
<div class="page-header">
    <h1 class="page-title"><i class="fas fa-file-contract me-2"></i>Rental #@Model.Id</h1>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-primary-custom"><i class="fas fa-edit me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
    </div>
</div>
<div class="row g-4">
    <div class="col-md-6">
        <div class="form-card">
            <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:12px;letter-spacing:1px">Rental Information</h6>
            <table class="table table-borderless">
                <tr><td class="text-muted">Status</td><td><span class="status-badge status-@Model.Status.ToLower()">@Model.Status</span></td></tr>
                <tr><td class="text-muted">Rental Date</td><td><strong>@Model.RentalDate.ToString("MMMM dd, yyyy")</strong></td></tr>
                <tr><td class="text-muted">Return Date</td><td><strong>@Model.ReturnDate.ToString("MMMM dd, yyyy")</strong></td></tr>
                @if (Model.ActualReturnDate.HasValue) { <tr><td class="text-muted">Actual Return</td><td>@Model.ActualReturnDate?.ToString("MMMM dd, yyyy")</td></tr> }
                <tr><td class="text-muted">Duration</td><td>@((Model.ReturnDate - Model.RentalDate).Days) days</td></tr>
                <tr><td class="text-muted">Total Amount</td><td><strong class="text-primary fs-5">₱@Model.TotalAmount.ToString("N2")</strong></td></tr>
                @if (!string.IsNullOrEmpty(Model.Notes)) { <tr><td class="text-muted">Notes</td><td>@Model.Notes</td></tr> }
                <tr><td class="text-muted">Created</td><td>@Model.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</td></tr>
            </table>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-card mb-4">
            <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:12px;letter-spacing:1px">Customer</h6>
            <table class="table table-borderless">
                <tr><td class="text-muted">Name</td><td><strong>@Model.Customer?.FullName</strong></td></tr>
                <tr><td class="text-muted">Email</td><td>@Model.Customer?.Email</td></tr>
                <tr><td class="text-muted">Phone</td><td>@Model.Customer?.Phone</td></tr>
                <tr><td class="text-muted">License</td><td><code>@Model.Customer?.LicenseNumber</code></td></tr>
            </table>
        </div>
        <div class="form-card">
            <h6 class="fw-bold mb-3 text-muted text-uppercase" style="font-size:12px;letter-spacing:1px">Car</h6>
            <table class="table table-borderless">
                <tr><td class="text-muted">Car</td><td><strong>@Model.Car?.Brand @Model.Car?.Model</strong></td></tr>
                <tr><td class="text-muted">Year</td><td>@Model.Car?.Year</td></tr>
                <tr><td class="text-muted">Plate</td><td><code>@Model.Car?.PlateNumber</code></td></tr>
                <tr><td class="text-muted">Daily Rate</td><td>₱@Model.Car?.DailyRate.ToString("N2")</td></tr>
            </table>
        </div>
    </div>
</div>
