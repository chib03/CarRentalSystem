@model CarRentalSystem.Models.RentalTransaction
@{ ViewData["Title"] = "Edit Rental"; }
<div class="page-header"><h1 class="page-title"><i class="fas fa-edit me-2"></i>Edit Rental #@Model.Id</h1></div>
<div class="form-card" style="max-width:560px">
    <div class="mb-4 p-3 rounded" style="background:#f8fafc;border:1px solid #e5e7eb;">
        <div class="row text-sm">
            <div class="col-6"><span class="text-muted d-block" style="font-size:12px">Customer</span><strong>@Model.Customer?.FullName</strong></div>
            <div class="col-6"><span class="text-muted d-block" style="font-size:12px">Car</span><strong>@Model.Car?.Brand @Model.Car?.Model</strong></div>
            <div class="col-6 mt-2"><span class="text-muted d-block" style="font-size:12px">Rental Date</span><strong>@Model.RentalDate.ToString("MMM dd, yyyy")</strong></div>
            <div class="col-6 mt-2"><span class="text-muted d-block" style="font-size:12px">Return Date</span><strong>@Model.ReturnDate.ToString("MMM dd, yyyy")</strong></div>
            <div class="col-6 mt-2"><span class="text-muted d-block" style="font-size:12px">Total Amount</span><strong class="text-primary">₱@Model.TotalAmount.ToString("N2")</strong></div>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label">Status</label>
            <select name="status" class="form-select">
                <option value="Pending" selected="@(Model.Status=="Pending")">Pending</option>
                <option value="Active" selected="@(Model.Status=="Active")">Active</option>
                <option value="Completed" selected="@(Model.Status=="Completed")">Completed</option>
                <option value="Cancelled" selected="@(Model.Status=="Cancelled")">Cancelled</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Actual Return Date (if completed)</label>
            <input type="date" name="actualReturnDate" class="form-control" value="@(Model.ActualReturnDate?.ToString("yyyy-MM-dd") ?? "")" />
        </div>
        <div class="mb-3">
            <label class="form-label">Notes</label>
            <textarea name="notes" class="form-control" rows="2">@Model.Notes</textarea>
        </div>
        <div class="d-flex gap-2">
            <button type="submit" class="btn-primary-custom"><i class="fas fa-save me-1"></i>Update Status</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
