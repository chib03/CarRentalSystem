@model CarRentalSystem.Models.AdminUserViewModel
@{ ViewData["Title"] = "Edit User"; var user = ViewBag.User as CarRentalSystem.Models.ApplicationUser; }
<div class="page-header"><h1 class="page-title"><i class="fas fa-user-edit me-2"></i>Edit User</h1></div>
<div class="form-card">
    <form asp-action="Edit" asp-route-id="@user?.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label">Full Name</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Username</label>
                <input class="form-control" value="@user?.UserName" disabled />
                <small class="text-muted">Username cannot be changed</small>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="Role" class="form-label">Role</label>
                <select asp-for="Role" class="form-select">
                    <option value="Customer">Customer</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <div class="col-12">
                <hr class="my-1" />
                <small class="text-muted">Leave password fields blank to keep existing password</small>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label">New Password <span class="text-muted">(optional)</span></label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Leave blank to keep current" />
            </div>
            <div class="col-md-6">
                <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                <input asp-for="ConfirmPassword" type="password" class="form-control" />
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn-primary-custom"><i class="fas fa-save me-1"></i>Update User</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
